# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPER_ADMIN_EMAIL: The email used to securely seed the Super Admin account on first startup.
# SUPER_ADMIN_INITIAL_PASSWORD: The initial password for the seeded Super Admin account. Requires reset on first login.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

# PAYMOB_API_KEY: Secret API key from Paymob Developer Dashboard (Settings or Developers)
PAYMOB_API_KEY=

# PAYMOB_INTEGRATION_ID: The acceptance integration ID (e.g. for card payments)
PAYMOB_INTEGRATION_ID=

# PAYMOB_IFRAME_ID: The ID of the checkout iframe to render (e.g. from the paymob portal)
PAYMOB_IFRAME_ID=

# PAYMOB_HMAC_SECRET: The secret phrase used to verify webhook transaction signature
PAYMOB_HMAC_SECRET=

# GCS_BUCKET_NAME: The name of your Google Cloud Storage bucket for document storage
GCS_BUCKET_NAME=

# GCS_SERVICE_ACCOUNT_KEY: The JSON string of your Google Cloud Service Account key that has Storage Object Admin role
GCS_SERVICE_ACCOUNT_KEY=


# --- Cloud SQL Configuration ---

# SQL_HOST: The IP address or hostname of the PostgreSQL database.
# ONLY used for local development or non-Cloud Run deployments.
SQL_HOST=

# SQL_INSTANCE_CONNECTION_NAME: The connection string for your Cloud SQL instance.
# Required for Cloud Run deployments. Found in GCP Console -> SQL -> your instance -> Overview -> "Connection name".
# Format usually looks like: project-id:region:instance-name
SQL_INSTANCE_CONNECTION_NAME=

# SQL_DB_NAME: The name of the specific database inside the Cloud SQL instance to connect to.
SQL_DB_NAME=

# SQL_ADMIN_USER: The PostgreSQL user used to connect to the database.
# Note: You need to create this user in GCP Console -> SQL -> Users -> Add User Account.
# It should have access to the database specified in SQL_DB_NAME.
SQL_ADMIN_USER=

# SQL_ADMIN_PASSWORD: The password for the SQL_ADMIN_USER.
SQL_ADMIN_PASSWORD=
